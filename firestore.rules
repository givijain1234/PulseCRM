rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, email, name, role (admin|employee|client), createdAt
    //
    // Collection: clients
    // Fields: id, name, email, phone, company, assignedEmployeeId, notes, createdAt
    //
    // Collection: receipts
    // Fields: id, clientId, amount, date, description, items, pdfUrl, createdAt
    //
    // Collection: tasks
    // Fields: id, clientId, title, status, dueDate, createdAt
    //
    // Collection: logs
    // Fields: id, userId, action, timestamp, details
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (request.auth.token.email == "givijain16@gmail.com" && request.auth.token.email_verified == true) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isEmployee() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employee';
    }

    function hasRole(role) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'employee', 'client'];
    }

    function isValidClient(data) {
      return data.keys().hasAll(['name', 'email']) &&
             data.name is string && data.name.size() > 0 &&
             data.email is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && (isAdmin() || (isOwner(userId) && request.resource.data.role == 'client'));
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && (isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isAdmin() || isEmployee() || (isAuthenticated() && request.auth.token.email == resource.data.email);
      allow create: if isAdmin() || isEmployee();
      allow update: if isAdmin() || isEmployee();
      allow delete: if isAdmin();
    }

    match /receipts/{receiptId} {
      allow read: if isAdmin() || isEmployee() || (isAuthenticated() && exists(/databases/$(database)/documents/clients/$(resource.data.clientId)) && get(/databases/$(database)/documents/clients/$(resource.data.clientId)).data.email == request.auth.token.email);
      allow create: if isAdmin() || isEmployee();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAdmin() || isEmployee();
      allow create: if isAdmin() || isEmployee();
      allow update: if isAdmin() || isEmployee();
      allow delete: if isAdmin();
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    match /posts/{postId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid;
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    match /likes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /events/{eventId} {
      allow get, list: if isAuthenticated();
      allow create: if isAdmin() || isEmployee();
      allow update: if isAdmin() || (isEmployee() && resource.data.organizerId == request.auth.uid);
      allow delete: if isAdmin() || (isEmployee() && resource.data.organizerId == request.auth.uid);

      match /registrations/{regId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }
  }
}
